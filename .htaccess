# CSC Digital Seva Portal - Apache Configuration
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Protect sensitive database & config files
<FilesMatch "^(\.env|\.git|\.htaccess|composer\.json|package\.json|.*\.sqlite|.*\.db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Increase upload limits if host allows override
<IfModule mod_php7.c>
    php_value upload_max_filesize 30M
    php_value post_max_size 35M
    php_value max_execution_time 300
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 30M
    php_value post_max_size 35M
    php_value max_execution_time 300
</IfModule>
