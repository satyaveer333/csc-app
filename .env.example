# ==============================================================================
# CSC Digital Seva Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CSC Digital Seva Portal"
APP_ENV=production          # Options: local, development, staging, production
APP_DEBUG=false             # Set false in production to suppress detailed error displays
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata

# 32-byte secret key for AES-256-CBC at-rest encryption (generate a random 64-hex string)
APP_SECRET_KEY=generate_a_random_32_byte_secret_key_here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Driver: 'sqlite' (zero-setup local development) or 'mysql' (production server)
DB_DRIVER=mysql

# SQLite settings (used when DB_DRIVER=sqlite)
SQLITE_FILE=data/csc_database.sqlite

# MySQL settings (used when DB_DRIVER=mysql on Serverbyt Blaze / cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=csc_db
DB_USER=csc_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. OWNER CREDENTIALS & SECURITY AUTHORIZATION
# ------------------------------------------------------------------------------
# Initial owner credentials (changeable from Owner Settings panel)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# Authorized Developer email (used for developer authorization security gates)
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_EMAIL_HASH=

# ------------------------------------------------------------------------------
# 4. CSC CENTER PROFILE DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_CENTER_NAME="Digital Solutions"
DEFAULT_OWNER_NAME="Digital Solutions Operator"
DEFAULT_OWNER_PHONE="9876543210"
DEFAULT_OWNER_EMAIL="csc.center@example.com"
DEFAULT_CENTER_ADDRESS="Main Market Road, Near Panchayat Bhawan"
DEFAULT_VLE_ID="CSC-98745612"

# ------------------------------------------------------------------------------
# 5. EMAIL & NOTIFICATION DISPATCH (SMTP & NATIVE MAIL)
# ------------------------------------------------------------------------------
# Delivery method: 'php_mail' (for Serverbyt Blaze native mail) or 'smtp' (custom SMTP server)
MAIL_METHOD=php_mail

# Custom SMTP server settings (Google Mail, SendGrid, Amazon SES, cPanel Webmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls             # 'tls' (port 587) or 'ssl' (port 465)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ------------------------------------------------------------------------------
# 6. CITIZEN PRINT UPLOADS & RESTRICTIONS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS="pdf,doc,docx,jpg,jpeg,png,txt,xls,xlsx"

# ------------------------------------------------------------------------------
# 7. SESSIONS, SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
SESSION_LIFETIME=172800
MIDNIGHT_POSTPONE_WINDOW=1800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_MINUTES=15
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
